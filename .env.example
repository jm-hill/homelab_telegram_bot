# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
AUTHORIZED_USER_IDS=123456789,987654321

# Services to Monitor
PROXMOX_URL=https://proxmox.yourdomain.com:8006
PORTAINER_URL=https://portainer.yourdomain.com
TRAEFIK_URL=https://traefik.yourdomain.com

# Optional API Keys
PROXMOX_TOKEN=your_proxmox_token
PORTAINER_TOKEN=your_portainer_token

# Docker Configuration
DOCKER_HOST=unix:///var/run/docker.sock

# --- Notifiarr Bridge Configuration ---

# Bridge bot token (defaults to BOT_TOKEN if not set)
# BRIDGE_BOT_TOKEN=your_bridge_bot_token_here

# Optional: Notifiarr API key for validation
# NOTIFIARR_API_KEY=your_notifiarr_api_key

# Bridge HTTP port (default: 5000)
# BRIDGE_PORT=5000

# Bridge log level (defaults to LOG_LEVEL, then INFO)
# BRIDGE_LOG_LEVEL=INFO

# Channel Mappings (Discord Channel ID -> Telegram Chat ID)
# Format: DISCORD_CHANNEL_ID=TELEGRAM_CHAT_ID
# For forum topics: DISCORD_CHANNEL_ID=TELEGRAM_CHAT_ID:TOPIC_ID
# Example:
# 735481457153277994=-1001234567890
# 631827062348512345=-1009876543210:42